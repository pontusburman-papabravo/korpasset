+    /// Window chosen for the in-flight Apple sheet. login() refuses to start
+    /// without one, so presentationAnchor does not invent an empty window.
+    private var presentationWindow: UIWindow?
+
+    /// Same rules as app/src/auth/apple-presentation.ts: foreground-active
+    /// scene only, visible key window, then any visible window. Never
+    /// UIApplication.shared.windows.first.
+    private func korpassetApplePresentationWindow() -> UIWindow? {
+        let activeWindows = UIApplication.shared.connectedScenes
+            .compactMap { $0 as? UIWindowScene }
+            .filter { $0.activationState == .foregroundActive }
+            .flatMap { $0.windows }
+        if let key = activeWindows.first(where: { $0.isKeyWindow && !$0.isHidden }) {
+            return key
+        }
+        return activeWindows.first(where: { !$0.isHidden })
+    }
