{
  "name": "bilklar-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed-taxonomy.ts",
    "admin:create": "tsx src/cli/create-admin.ts",
    "test": "tsx --import ./tests/register-hooks.ts --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^8.1.1",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.14.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/qrcode": "^1.5.5",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
