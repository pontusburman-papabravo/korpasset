# Local and production runtime configuration. Copy to app/.env and fill in.
# Never commit real secrets.

# production | unset for local development
NODE_ENV=development

# Required in production. Local docker-compose default:
# DATABASE_URL=postgresql://bilklar:bilklar@localhost:54329/bilklar_test
DATABASE_URL=

# Required in production. At least 32 random characters. Not the dev default.
SESSION_SECRET=

# Canonical public origin. Production must be https://korpasset.se
APP_BASE_URL=http://localhost:3000

PORT=3000

# Optional. Cookie Secure follows APP_BASE_URL unless overridden.
# COOKIE_SECURE=true

# Optional. Only for local production-like runs on http://localhost
# ALLOW_HTTP=true

# Optional. Resend API key for admin password-reset emails.
# Without it, /admin/forgot-password still shows the same public message
# and logs a server-side failure. Tokens are created before send.
# RESEND_API_KEY=

# Optional. Resend webhook signing secret (Dashboard → Webhooks).
# Endpoint: POST /api/resend/webhook
# Without it the route returns 503. Register the webhook only after deploy.
# RESEND_WEBHOOK_SECRET=

# Optional. Default: Körpasset <support@korpasset.se>
# EMAIL_FROM=Körpasset <support@korpasset.se>

# Product OAuth. Without these, POST /api/auth/apple and /api/auth/google return 503.
# Identity key is Apple/Google sub, not email. Not required for waitlist.
# Google IDs must be real *.apps.googleusercontent.com — not <placeholder> values.
# APPLE_BUNDLE_ID=se.korpasset.app
# APPLE_TEAM_ID=PQ7M3B7VW5
# APPLE_CLIENT_ID=se.korpasset.app
# APPLE_CLIENT_IDS=se.korpasset.app
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_IDS=
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# ANDROID_PACKAGE_NAME=se.korpasset.app
# ANDROID_SHA256_CERT_FINGERPRINTS=

# Off in production. Local/test default on so the slice can still create a guest student.
# ALLOW_GUEST_STUDENT_ONBOARDING=false

# Optional. GA4 measurement id. The tag is not loaded until a visitor
# opts in to analytics in the cookie banner. Invalid values are ignored.
# Production default is G-H275WSBLJ8. Set empty to disable.
# GA_MEASUREMENT_ID=G-H275WSBLJ8

# Optional. Meta Pixel id. The script is not loaded, and no PageView or Lead
# is sent, until a visitor opts in to marketing cookies. Invalid values are ignored.
# META_PIXEL_ID=1358346629475279
