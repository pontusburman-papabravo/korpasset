# Copy to deploy/.env on the VPS. Never commit real values.
# On the live server, append missing keys — do not rotate POSTGRES_PASSWORD
# or SESSION_SECRET (that would lock out the database and admin cookies).
# scripts/vps-deploy-revision.sh refuses empty POSTGRES_PASSWORD,
# SESSION_SECRET, RESEND_API_KEY, and RESEND_WEBHOOK_SECRET.
POSTGRES_PASSWORD=
SESSION_SECRET=
APP_BASE_URL=https://korpasset.se
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Optional. Default: Körpasset <support@korpasset.se>
EMAIL_FROM=Körpasset <support@korpasset.se>
# Native app OAuth and Universal/App Links.
# Production boot fails without APPLE_TEAM_ID, an Apple audience, a Google
# audience, and GOOGLE_IOS_CLIENT_ID — so login cannot silently 503.
# Do not rotate values that already work on the VPS.
# assetlinks.json stays [] until ANDROID_SHA256_CERT_FINGERPRINTS is a real
# Play App Signing SHA-256 (colon-hex). Do not invent one.
# Google IDs must be real *.apps.googleusercontent.com values. Documentation
# placeholders like <web-client-id> crash Google Sign-In on iPhone.
APPLE_BUNDLE_ID=se.korpasset.app
APPLE_TEAM_ID=PQ7M3B7VW5
APPLE_CLIENT_ID=
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
ANDROID_PACKAGE_NAME=se.korpasset.app
ANDROID_SHA256_CERT_FINGERPRINTS=
# GA4. The tag is not loaded until a visitor opts in to analytics.
# Override or set empty to turn measurement off.
GA_MEASUREMENT_ID=G-H275WSBLJ8
# Meta Pixel. The script is not loaded until a visitor opts in to marketing.
# Override or set empty to turn the pixel off.
META_PIXEL_ID=1358346629475279
