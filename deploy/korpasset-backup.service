[Unit]
Description=Körpasset Postgres backup (14-day retention)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=VPS_APP_PATH=/var/www/korpasset
Environment=KORPASSET_BACKUP_DIR=/var/backups/korpasset
ExecStart=/var/www/korpasset/scripts/vps-backup.sh
Nice=10
