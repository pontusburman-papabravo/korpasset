{
	email pontus.burman@papabravo.se
}

www.korpasset.se {
	redir https://korpasset.se{uri} permanent
}

korpasset.se {
	@compressible not path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	encode @compressible gzip zstd
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	reverse_proxy app:3000
}

http://www.papabravo.se {
	redir https://papabravo.se{uri} permanent
}

www.papabravo.se {
	redir https://papabravo.se{uri} permanent
}

papabravo.se {
	root * /data/sites/papabravo
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
		-Server
	}
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' mailto:; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'"

	@static path *.css *.js *.woff2 *.webp *.png *.svg *.jpg *.jpeg *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"

	@html path *.html /
	header @html Cache-Control "public, max-age=300"

	@legacy path /startsida /startsida/ /startsida/lab /startsida/lab/ /startsida/lab/spel-tetsudo /startsida/lab/spel-tetsudo/ /startsida/lab/spel-m-tetsudo /startsida/lab/spel-m-tetsudo/
	redir @legacy https://papabravo.se/ permanent

	@slash path_regexp slash ^(.+)/$
	redir @slash https://papabravo.se{re.slash.1} permanent

	handle {
		try_files {path} {path}.html {path}/index.html
		file_server {
			hide /etc/caddy/Caddyfile
		}
	}

	handle_errors {
		root * /data/sites/papabravo
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server {
			hide /etc/caddy/Caddyfile
		}
	}
}
